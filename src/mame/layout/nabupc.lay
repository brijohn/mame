<mamelayout version="2">
	<element name="yellow" defstate="0">
		<rect state="1">
			<color red="0.75" green="0.75" blue="0.0" />
		</rect>
		<rect state="0">
			<color red="0.20" green="0.20" blue="0.0" />
		</rect>
	</element>
	<element name="red" defstate="0">
